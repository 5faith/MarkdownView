{
  "name": "markdown-view",
  "private": true,
  "version": "0.2.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/patch-vditor.cjs",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "postinstall": "node scripts/patch-vditor.cjs",
    "clean": "node -e \"require('fs').readdirSync('src',{recursive:true}).filter(f=>f.endsWith('.js')||f.endsWith('.vue.js')).forEach(f=>require('fs').unlinkSync('src/'+f))\"",
    "predev": "node -e \"try{require('fs').readdirSync('src',{recursive:true}).filter(f=>f.endsWith('.js')||f.endsWith('.vue.js')).forEach(f=>require('fs').unlinkSync('src/'+f))}catch(e){}\""
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.9",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.2.2",
    "@tauri-apps/plugin-fs": "^2.3.0",
    "@tauri-apps/plugin-process": "^2.2.2",
    "codemirror": "^6.0.2",
    "material-file-icons": "^2.4.0",
    "pinia": "^3.0.3",
    "vditor": "^3.10.9",
    "vue": "^3.5.13",
    "vue-codemirror": "^6.1.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "sass": "^1.89.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vue-tsc": "^2.2.10"
  }
}
