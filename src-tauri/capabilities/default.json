{
  "$schema": "https://raw.githubusercontent.com/nicholasoxford/tauri-v2-schema/main/schemas/capabilities.schema.json",
  "identifier": "default",
  "description": "Capability for all windows",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    "fs:default",
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-exists",
    "fs:allow-read-dir",
    "fs:read-all",
    "fs:write-all",
    "process:default",
    "process:allow-exit",
    "core:event:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "**" }
      ]
    }
  ]
}
