{
  "$schema": "https://raw.githubusercontent.com/nicholasoxford/tauri-v2-schema/main/schemas/tauri.conf.schema.json",
  "productName": "MarkdownView",
  "version": "0.2.6",
  "identifier": "com.markdownview.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:14220",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "MarkdownView",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/style3-dark-app-icon-32.png",
      "icons/style3-dark-app-icon-128.png",
      "icons/style3-dark-app-icon-256.png",
      "icons/style3-dark-app-icon.icns",
      "icons/style3-dark-app-icon.ico"
    ],
    "resources": [
      "icons/style3-dark-file-icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "fileAssociations": [
      {
        "ext": ["md"],
        "name": "Markdown",
        "mimeType": "text/markdown"
      },
      {
        "ext": ["markdown"],
        "name": "Markdown",
        "mimeType": "text/markdown"
      },
      {
        "ext": ["mdown"],
        "name": "Markdown",
        "mimeType": "text/markdown"
      },
      {
        "ext": ["mkd"],
        "name": "Markdown",
        "mimeType": "text/markdown"
      }
    ]
  }
}
