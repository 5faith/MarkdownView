{
  "$schema": "https://raw.githubusercontent.com/nicholasoxford/tauri-v2-schema/main/schemas/tauri.conf.schema.json",
  "productName": "MarkdownView",
  "version": "0.2.4",
  "identifier": "com.markdownview.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:14200",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "MarkdownView",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "fileAssociations": [
      {
        "ext": ["md"],
        "name": "Markdown",
        "mimeType": "text/markdown"
      },
      {
        "ext": ["markdown"],
        "name": "Markdown",
        "mimeType": "text/markdown"
      },
      {
        "ext": ["mdown"],
        "name": "Markdown",
        "mimeType": "text/markdown"
      },
      {
        "ext": ["mkd"],
        "name": "Markdown",
        "mimeType": "text/markdown"
      }
    ]
  }
}
